  "description": "MySQL and MariaDB storage for eventualize-js (Prisma client factory).",
  "keywords": [
    "event-sourcing",
    "eventualize",
    "typescript",
    "mysql",
    "mariadb",
    "prisma",
    "storage-adapter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/outsidenote/eventualize-js",
    "directory": "packages/adapters/mysql-storage-adapter"
  },
