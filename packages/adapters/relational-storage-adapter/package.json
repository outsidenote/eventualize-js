{
  "name": "@eventualize/relational-storage-adapter",
  "version": "6.2.0",
  "description": "Prisma-based eventualize-js storage adapter for SQL databases.",
  "keywords": [
    "event-sourcing",
    "eventualize",
    "typescript",
    "prisma",
    "sql",
    "storage-adapter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/outsidenote/eventualize-js",
    "directory": "packages/adapters/relational-storage-adapter"
  },
  "homepage": "https://github.com/outsidenote/eventualize-js/tree/main/packages/adapters/relational-storage-adapter#readme",
  "bugs": {
    "url": "https://github.com/outsidenote/eventualize-js/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "echo not tests implemented yet."
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@eventualize/types": "workspace:^",
    "@prisma/client": "7.10.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.7.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "~1.9.1",
    "dotenv": "^18.0.9",
    "prisma": "7.10.1"
  },
  "files": [
    "dist"
  ]
}
