{
  "name": "@eventualize/core",
  "version": "6.2.1",
  "description": "Type-safe event sourcing for TypeScript: streams, views, snapshots, outbox messages, replay and OpenTelemetry tracing.",
  "keywords": [
    "event-sourcing",
    "eventualize",
    "typescript",
    "cqrs",
    "outbox",
    "replay",
    "opentelemetry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/outsidenote/eventualize-js",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/outsidenote/eventualize-js/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/outsidenote/eventualize-js/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./otel": {
      "import": "./dist/otel/index.js",
      "types": "./dist/otel/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "echo not tests implemented yet."
  },
  "dependencies": {
    "@eventualize/types": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.7.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0"
  },
  "license": "ISC",
  "type": "module",
  "files": [
    "dist"
  ]
}
