{
  "name": "e2e-funds",
  "version": "1.0.0",
  "private": true,
  "description": "E2E demo: funds deposit/withdrawal with CDC outbox → Kafka → read models",
  "type": "module",
  "imports": {
    "#abstractions/*": "./src/abstractions/*",
    "#BusinessCapabilities/*": "./src/BusinessCapabilities/*"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "start": "node --import tsx src/index.ts",
    "start:main": "node --import tsx src/server.ts",
    "start:risk": "node --import tsx src/risk-server.ts",
    "test:unit": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@eventualize/core": "workspace:^",
    "@eventualize/postgres-storage-adapter": "workspace:^",
    "@eventualize/relational-storage-adapter": "workspace:^",
    "@eventualize/types": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prisma/adapter-pg": "7.10.0",
    "express": "^4.22.3",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.21.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
