{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules/@eventualize/core/src/**/*.test.ts", "node_modules/@eventualize/core/src/otel/otel.test.ts"]
}
