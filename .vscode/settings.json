{
    "npm.scriptExplorerAction": "run",
    "debug.console.closeOnEnd": false,
    // Node.js Test Runner (connor4312.nodejs-testing).
    // Run the TypeScript sources through tsx, the same way `pnpm test` does.
    // Compiled `.js` tests (dist/ and stale outputs in src/) are not test files:
    // running them executes old build output and duplicates the tree.
    "nodejs-testing.include": [
        "./packages",
        "./apps"
    ],
    "nodejs-testing.exclude": [
        "**/node_modules/**",
        "**/dist/**"
    ],
    "nodejs-testing.extensions": [
        {
            "extensions": ["ts", "mts", "cts"],
            "filePatterns": ["**/*.test.ts", "**/*.test.mts", "**/*.test.cts"],
            "parameters": ["--import", "tsx"]
        }
    ],
    "nodejs-testing.envFile": "${workspaceFolder}/.env.test",
    "nodejs-testing.env": {
        "TEST_CONTAINER": "true"
    },
    "[typescript]": {
      "editor.defaultFormatter": "vscode.typescript-language-features"
    }
}
